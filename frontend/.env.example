# Server-only. Never prefix these with NEXT_PUBLIC_.
CLUTCH_API_BASE_URL=http://localhost:8000
CLUTCH_API_KEY=
# Required for production authentication. Use a random value of 32+ characters.
CLUTCH_SESSION_SECRET=
STYTCH_PROJECT_ID=
STYTCH_SECRET=
STYTCH_ENVIRONMENT=test
# Add this exact URL as both a signup and login redirect in Stytch.
STYTCH_REDIRECT_URL=http://localhost:3000/api/auth/callback
# Anonymous development requires an explicit opt-in and is disabled on Vercel.
CLUTCH_ALLOW_LOCAL_ANONYMOUS=false
